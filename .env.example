# Copiar a .env y completar. .env esta en .gitignore: nunca se commitea.
# Este archivo SI se versiona, y por eso solo lleva valores de ejemplo.
#
# Agregar aca cada variable nueva que el sistema necesite, con un valor de
# ejemplo evidente (<...>), para que quien clone el repo sepa que configurar.

# --- Base de datos ---
# DATABASE_URL=postgres://<usuario>:<password>@localhost:5432/<base>

# --- Servicios externos ---
# API_KEY=<tu-clave>
